---
import Base from '../../layouts/Base.astro';
import ProductView from '../../components/ProductView.astro';
import { products, categories, catAccent, byCategory, cardSpecs } from '../../data/catalog';
import type { Product } from '../../data/catalog';
import { u } from '../../data/url';

export function getStaticPaths() {
  return products.map((p) => ({ params: { id: p.id }, props: { p } }));
}
const { p } = Astro.props as { p: Product };
const cat = categories[p.category];
const related = byCategory(p.category).filter((x) => x.id !== p.id).slice(0, 3);
const specEntries = Object.entries(p.specs);
const lead = specEntries.slice(0, 3).map(([k, v]) => `${k}: ${v}`).join('; ');
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.name,
  category: cat.name,
  description: p.about || `${p.name} exported by Geo Excel. ${lead}`,
  brand: { '@type': 'Brand', name: 'Geo Excel' },
};
---
<Base
  title={`${p.name} | ${cat.name}`}
  description={`${p.name}: specification sheet. ${lead}. Request a quote from Geo Excel, Bangalore.`.slice(0, 300)}
  jsonLd={ld}
>
  <ProductView product={{ slug: p.id, name: p.name, category: cat.name, about: p.about, image: p.image, specs: p.specs, note: p.note }} />

  {related.length > 0 && (
    <section class="section alt">
      <div class="wrap">
        <h2>More in {cat.name}</h2>
        <div class="grid">
          {related.map((r) => (
            <article class="pcard" style={`--accent:${catAccent[r.category]}`}>
              <a class="pimg" href={u(`products/${r.id}/`)} tabindex="-1" aria-hidden="true"><img src={u(r.image)} alt="" width="360" height="270" loading="lazy" decoding="async" /></a>
              <h3><a href={u(`products/${r.id}/`)}>{r.name}</a></h3>
              <dl class="mini">{cardSpecs(r).map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
              <div class="actions">
                <a class="btn btn-sm" href={u(`products/${r.id}/`)}>Spec sheet</a>
                <button class="btn btn-sm btn-primary" type="button" data-add={r.id} aria-pressed="false"><span class="lbl">Add to enquiry</span></button>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}
</Base>
