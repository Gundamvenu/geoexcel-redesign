---
import Base from '../layouts/Base.astro';
import { company, credentials } from '../data/company';
import { u } from '../data/url';
---
<Base
  title="Credentials | APEDA, FSSAI, Leather Exports, Udyam, IEC"
  description="The registrations Geo Excel publishes — APEDA RCMC, FSSAI central licence, Council for Leather Exports RCMC, Udyam and IEC — with scope and dates as printed, and copies of each certificate."
>
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">Credentials</p>
      <h1>What each registration covers</h1>
      <p>
        Geo Excel publishes five registration copies for {company.legalName}. Here is each one in plain text, with its scope and dates exactly as printed,
        so you can verify it with the issuing body. A registration applies only to what it names.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top:8px">
    <div class="wrap">
      <p class="flag" style="margin-bottom:12px"><strong>Please note:</strong> dates and scope below are transcribed from the copies published on geoexcel.group. Two copies show validity dates that have passed (flagged below). They need current copies from the company, and a buyer should always verify with the issuing authority.</p>
      {credentials.map((c) => (
        <article class="cred-big" id={c.id}>
          <div>
            <span class="tag">{c.short}</span>
            <h2 style="font-size:1.7rem;margin-top:12px">{c.title}</h2>
            <div class="cred" style="border:0;padding:0;background:none">
              <dl>
                <dt>Issuer</dt><dd>{c.issuer}</dd>
                <dt>Holder</dt><dd>{company.legalName}</dd>
                <dt>Scope</dt><dd>{c.scope}</dd>
                <dt>Issued</dt><dd>{c.issued}</dd>
                <dt>Valid to</dt><dd>{c.validTo}</dd>
              </dl>
              {c.note && <p class="flag">{c.note}</p>}
            </div>
          </div>
          <a class="doc" href={u(`certs/${c.file}.webp`)} target="_blank" rel="noopener" aria-label={`Open full-size copy: ${c.title} (opens in a new tab)`}>
            <img src={u(`certs/${c.file}-thumb.webp`)} alt={c.alt} loading="lazy" decoding="async" width="700" />
          </a>
        </article>
      ))}
      <p class="muted" style="margin-top:28px">Certificate copies are reproduced from the company’s public website. Personal identifiers on them are the company’s own published content.</p>
      <p><a class="btn btn-primary" href={u('enquiry/')}>Ask about a specific product or document</a></p>
    </div>
  </section>
</Base>
