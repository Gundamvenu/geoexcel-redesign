---
import Base from '../layouts/Base.astro';
import { company } from '../data/company';
import { u } from '../data/url';
---
<Base
  title="Request a quote | Enquiry"
  description="Send Geo Excel a structured quote request: choose products, add quantity and destination, and send. Phone +91 8035110602, email info@geoexcel.group, Bangalore, India."
>
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">Request a quote</p>
      <h1>Tell us what you need to ship</h1>
      <p>Products you added are already in the list below. Add quantity and destination, and send.</p>
    </div>
  </section>

  <section class="section" style="padding-top:8px">
    <div class="wrap form-wrap">
      <form class="enquiry" id="enquiry" novalidate data-email={company.email}>
        <div class="basket" id="basket">
          <strong>Products in this enquiry <span class="count" data-count>0</span></strong>
          <p class="muted" style="margin:4px 0 0;font-size:.9rem">Each product has its own pack size, packaging and quantity, taken from its specification.</p>
          <div id="load-state" class="loadstate" hidden></div>
          <div class="adder">
            <label for="add-filter"><strong>Add another product</strong></label>
            <div class="adder-row">
              <input id="add-filter" type="search" placeholder="Filter, e.g. cumin" autocomplete="off" aria-controls="add-select" />
              <select id="add-select" aria-label="Choose a product to add"></select>
              <button type="button" class="btn btn-sm btn-primary" id="add-btn">+ Add to quote</button>
            </div>
            <details class="custom">
              <summary>Product not in the list?</summary>
              <div class="adder-row">
                <input id="add-custom" type="text" placeholder="Product name" autocomplete="off" aria-label="Name of a product that is not listed" />
                <button type="button" class="btn btn-sm" id="add-custom-btn">+ Add</button>
              </div>
            </details>
            <p class="sr-only" id="add-status" role="status" aria-live="polite"></p>
          </div>
          <ul id="basket-list"></ul>
          <p class="muted" id="basket-empty" style="margin:8px 0 0;font-size:.95rem">None yet. <a href={u('products/')}>Browse the catalogue</a> or describe what you need in the message.</p>
        </div>

        <div class="row">
          <div class="field">
            <label for="name">Your name <span class="req" aria-hidden="true">*</span></label>
            <input id="name" name="name" type="text" autocomplete="name" required maxlength="120" aria-describedby="name-err" />
            <span class="err" id="name-err"></span>
          </div>
          <div class="field">
            <label for="company">Company <span class="req" aria-hidden="true">*</span></label>
            <input id="company" name="company" type="text" autocomplete="organization" required maxlength="160" aria-describedby="company-err" />
            <span class="err" id="company-err"></span>
          </div>
        </div>
        <div class="row">
          <div class="field">
            <label for="email">Email <span class="req" aria-hidden="true">*</span></label>
            <input id="email" name="email" type="email" autocomplete="email" required maxlength="254" aria-describedby="email-err" />
            <span class="err" id="email-err"></span>
          </div>
          <div class="field">
            <label for="phone">Phone / WhatsApp <span class="hint">(optional)</span></label>
            <input id="phone" name="phone" type="tel" autocomplete="tel" maxlength="40" />
          </div>
        </div>
        <div class="row">
          <div class="field">
            <label for="country">Destination country <span class="req" aria-hidden="true">*</span></label>
            <input id="country" name="country" type="text" autocomplete="country-name" required maxlength="80" aria-describedby="country-err" />
            <span class="err" id="country-err"></span>
          </div>
          <div class="field">
            <label for="qty">Total volume / shipment <span class="hint">(optional)</span></label>
            <input id="qty" name="qty" type="text" placeholder="e.g. one 20 ft container" maxlength="120" />
          </div>
        </div>
        <div class="field">
          <label for="message">Message <span class="hint">(pack size, grade, documents needed, timing)</span></label>
          <textarea id="message" name="message" maxlength="3500"></textarea>
        </div>
        <!-- Honeypot: invisible to people, tempting to bots. Anything typed here makes the server discard the request silently. -->
        <div class="hp" aria-hidden="true">
          <label for="website">Leave this field empty</label>
          <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div>
          <button class="btn btn-primary" type="submit" id="send">Send enquiry</button>
        </div>
        <div class="status" id="status" role="status" tabindex="-1" hidden></div>
        <div id="fallback" hidden>
          <p class="muted" style="margin:0 0 10px">You can also email this to <a href={`mailto:${company.email}`}>{company.email}</a>. Copy the message below.</p>
          <textarea id="copy-text" readonly aria-label="Enquiry text to copy" style="min-height:160px"></textarea>
          <button class="btn btn-sm" type="button" id="copy" style="margin-top:10px">Copy message</button>
        </div>
      </form>

      <aside class="contact-card" aria-label="Contact details">
        <h2 style="font-size:1.4rem">Prefer to talk or write?</h2>
        <address>
          <div><span class="k">Phone</span><a href={`tel:${company.phoneHref}`}>{company.phone}</a></div>
          <div><span class="k">Email</span><a href={`mailto:${company.email}`}>{company.email}</a></div>
          <div><span class="k">Registered office</span>{company.addressLines.join(', ')}</div>
          <div><span class="k">Company</span>{company.legalName}</div>
        </address>
      </aside>
    </div>
  </section>

  <script>
    import { getBasket, remove, clear, add } from '../scripts/basket';
    import { fetchProducts, submitQuotation, ApiError, type DbProduct, type QuotationItemInput } from '../lib/api';
    import { enquiryOptions, enquiryFacts, type EnquiryOption } from '../lib/specs';
    import { setState } from '../lib/dom';

    type Info = { id: string; name: string; cat: string; facts: [string, string][]; options: EnquiryOption[] };
    const form = document.getElementById('enquiry') as HTMLFormElement;
    const status = document.getElementById('status')!;
    const fallback = document.getElementById('fallback')!;
    const list = document.getElementById('basket-list')!;
    const emptyMsg = document.getElementById('basket-empty')!;
    const send = document.getElementById('send') as HTMLButtonElement;
    const loadState = document.getElementById('load-state')!;

    // Catalogue as loaded from Supabase, keyed by slug (the basket stores slugs).
    let info: Record<string, Info> = {};

    // Per-product choices live in localStorage next to the basket so they survive navigation.
    const DKEY = 'geoexcel-enquiry-details';
    const loadD = (): Record<string, Record<string, string>> => { try { return JSON.parse(localStorage.getItem(DKEY) || '{}'); } catch { return {}; } };
    let details = loadD();
    const saveD = () => { try { localStorage.setItem(DKEY, JSON.stringify(details)); } catch { /* storage blocked */ } };
    // Products typed in by the visitor that are not in the catalogue.
    type Custom = { id: string; name: string; qty: string; notes: string };
    const CKEY = 'geoexcel-enquiry-custom';
    let customs: Custom[] = [];
    try { customs = JSON.parse(localStorage.getItem(CKEY) || '[]'); } catch { customs = []; }
    const saveC = () => { try { localStorage.setItem(CKEY, JSON.stringify(customs)); } catch { /* storage blocked */ } };

    const filterEl = document.getElementById('add-filter') as HTMLInputElement;
    const selectEl = document.getElementById('add-select') as HTMLSelectElement;
    const addStatus = document.getElementById('add-status')!;
    const customInput = document.getElementById('add-custom') as HTMLInputElement;

    function toInfo(p: DbProduct): Info {
      return { id: p.id, name: p.name, cat: p.category, facts: enquiryFacts(p), options: enquiryOptions(p) };
    }

    function drawBasket() {
      const ids = getBasket().filter((id) => info[id]);
      list.replaceChildren(...ids.map((id) => {
        const it = info[id];
        const li = document.createElement('li'); li.className = 'line'; li.dataset.id = id;
        const head = document.createElement('div'); head.className = 'line-head';
        const title = document.createElement('div');
        const strong = document.createElement('strong'); strong.textContent = it.name;
        const cat = document.createElement('div'); cat.className = 'muted'; cat.style.fontSize = '.8rem'; cat.textContent = it.cat;
        title.append(strong, cat);
        const b = document.createElement('button'); b.type = 'button'; b.textContent = '×';
        b.setAttribute('aria-label', `Remove ${it.name}`);
        b.addEventListener('click', () => remove(id));
        head.append(title, b);
        li.append(head);
        if (it.facts.length) {
          const facts = document.createElement('div'); facts.className = 'line-facts';
          it.facts.forEach(([k, v]) => { const s = document.createElement('span'); const kb = document.createElement('b'); kb.textContent = k + ': '; s.append(kb, v); facts.append(s); });
          li.append(facts);
        }
        const fields = document.createElement('div'); fields.className = 'line-fields';
        const d = (details[id] ||= {});
        const mk = (key: string, label: string, el: HTMLElement) => {
          const wrap = document.createElement('div'); const lab = document.createElement('label'); lab.textContent = label;
          const uid = `f-${id}-${key}`; el.id = uid; lab.htmlFor = uid; wrap.append(lab, el); fields.append(wrap);
        };
        it.options.forEach((o) => {
          const sel = document.createElement('select');
          sel.append(new Option('Not specified', ''));
          o.values.forEach((v) => sel.append(new Option(v, v)));
          sel.value = d[o.key] || '';
          sel.addEventListener('change', () => { d[o.key] = sel.value; saveD(); });
          mk(o.key, o.label, sel);
        });
        const q = document.createElement('input'); q.type = 'text'; q.placeholder = 'e.g. 25 MT'; q.value = d.qty || ''; q.maxLength = 60;
        q.addEventListener('input', () => { d.qty = q.value; saveD(); });
        mk('qty', 'Quantity', q);
        li.append(fields);
        return li;
      }));
      list.append(...customs.map(customLine));
      emptyMsg.hidden = ids.length + customs.length > 0;
      fillPicker();
    }

    function customLine(c: Custom) {
      const li = document.createElement('li'); li.className = 'line'; li.dataset.id = c.id;
      const head = document.createElement('div'); head.className = 'line-head';
      const title = document.createElement('div');
      const strong = document.createElement('strong'); strong.textContent = c.name;
      const cat = document.createElement('div'); cat.className = 'muted'; cat.style.fontSize = '.8rem'; cat.textContent = 'Not in catalogue';
      title.append(strong, cat);
      const b = document.createElement('button'); b.type = 'button'; b.textContent = '×'; b.setAttribute('aria-label', `Remove ${c.name}`);
      b.addEventListener('click', () => { customs = customs.filter((x) => x.id !== c.id); saveC(); drawBasket(); });
      head.append(title, b);
      const fields = document.createElement('div'); fields.className = 'line-fields';
      const mk = (key: 'qty' | 'notes', label: string, ph: string) => {
        const wrap = document.createElement('div'); const lab = document.createElement('label'); lab.textContent = label;
        const inp = document.createElement('input'); inp.type = 'text'; inp.placeholder = ph; inp.value = c[key]; inp.id = `f-${c.id}-${key}`; inp.maxLength = 200; lab.htmlFor = inp.id;
        inp.addEventListener('input', () => { c[key] = inp.value; saveC(); });
        wrap.append(lab, inp); fields.append(wrap);
      };
      mk('qty', 'Quantity', 'e.g. 25 MT'); mk('notes', 'Specification / notes', 'grade, pack size...');
      li.append(head, fields);
      return li;
    }

    // ---- "Add another product" picker (lists what Supabase returned) ----
    function fillPicker() {
      const have = new Set(getBasket());
      const term = filterEl.value.trim().toLowerCase();
      const groups = new Map<string, HTMLOptGroupElement>();
      selectEl.replaceChildren();
      let n = 0;
      Object.entries(info).forEach(([slug, it]) => {
        if (have.has(slug) || (term && !(it.name + ' ' + it.cat).toLowerCase().includes(term))) return;
        let g = groups.get(it.cat);
        if (!g) { g = document.createElement('optgroup'); g.label = it.cat; groups.set(it.cat, g); selectEl.append(g); }
        g.append(new Option(it.name, slug)); n++;
      });
      if (!n) selectEl.append(new Option(Object.keys(info).length === 0 ? 'Products not loaded' : term ? 'No matching product' : 'All products added', ''));
      selectEl.disabled = n === 0;
    }
    filterEl.addEventListener('input', fillPicker);
    function focusLine(id: string) {
      const li = list.querySelector<HTMLElement>(`li[data-id="${CSS.escape(id)}"]`);
      li?.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      li?.querySelector<HTMLElement>('select, input')?.focus({ preventScroll: true });
    }
    document.getElementById('add-btn')!.addEventListener('click', () => {
      const slug = selectEl.value;
      if (!slug || !info[slug]) { addStatus.textContent = 'Choose a product to add.'; filterEl.focus(); return; }
      add(slug); // triggers basket:change, which redraws the lines
      addStatus.textContent = `${info[slug].name} added to your quote.`;
      filterEl.value = ''; fillPicker(); focusLine(slug);
    });
    function addCustom() {
      const name = customInput.value.trim();
      if (!name) { addStatus.textContent = 'Type a product name first.'; customInput.focus(); return; }
      const c = { id: `c${Date.now()}`, name: name.slice(0, 80), qty: '', notes: '' };
      customs.push(c); saveC(); customInput.value = ''; drawBasket();
      addStatus.textContent = `${c.name} added to your quote.`; focusLine(c.id);
    }
    document.getElementById('add-custom-btn')!.addEventListener('click', addCustom);
    customInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); addCustom(); } });
    filterEl.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); (document.getElementById('add-btn') as HTMLButtonElement).click(); } });
    document.addEventListener('basket:change', drawBasket);

    async function loadProducts() {
      setState(loadState, 'loading', 'Loading products…');
      send.disabled = true;
      try {
        const rows = await fetchProducts();
        info = Object.fromEntries(rows.map((p) => [p.slug, toInfo(p)]));
        setState(loadState, rows.length ? 'none' : 'empty', 'No products are listed right now. You can still describe what you need below.');
        // ?p=slug1,slug2 pre-selects products (used by "Quote this product now").
        new URLSearchParams(location.search).get('p')?.split(',').forEach((s) => { if (info[s]) add(s); });
      } catch (e) {
        info = {};
        setState(loadState, 'error', (e instanceof ApiError ? e.message : 'Products could not be loaded.') + ' You can still describe what you need in the message.', loadProducts);
      } finally {
        send.disabled = false;
        drawBasket();
      }
    }

    // ---- form ----
    const field = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
    const rules: Record<string, (v: string) => string> = {
      name: (v) => (v.trim().length >= 2 ? '' : 'Please enter your name.'),
      company: (v) => (v.trim() ? '' : 'Please enter your company name.'),
      email: (v) => (/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim()) ? '' : 'Please enter a valid email address.'),
      country: (v) => (v.trim() ? '' : 'Please enter the destination country.'),
    };
    function validate(): boolean {
      let first: HTMLInputElement | null = null;
      for (const [n, rule] of Object.entries(rules)) {
        const el = field(n);
        const msg = rule(el.value);
        document.getElementById(`${n}-err`)!.textContent = msg;
        el.setAttribute('aria-invalid', String(!!msg));
        if (msg && !first) first = el;
      }
      first?.focus();
      return !first;
    }
    Object.keys(rules).forEach((n) => field(n).addEventListener('input', () => {
      if (field(n).getAttribute('aria-invalid') === 'true') {
        const msg = rules[n](field(n).value);
        document.getElementById(`${n}-err`)!.textContent = msg;
        field(n).setAttribute('aria-invalid', String(!!msg));
      }
    }));

    const numberOf = (t: string) => { const n = parseFloat(t.replace(/,/g, '')); return Number.isFinite(n) && n > 0 && n <= 1e9 ? n : null; };

    function buildItems(): QuotationItemInput[] {
      const items: QuotationItemInput[] = [];
      getBasket().filter((id) => info[id]).forEach((slug) => {
        const it = info[slug]; const d = details[slug] || {};
        const picks = it.options.filter((o) => d[o.key]).map((o) => `${o.label}: ${d[o.key]}`);
        const qty = (d.qty || '').trim();
        if (qty) picks.push(`Quantity: ${qty}`);
        items.push({ product_id: it.id, quantity: qty ? numberOf(qty) : null, note: picks.join(' | ').slice(0, 500) || null });
      });
      customs.forEach((c) => {
        const qty = c.qty.trim();
        const picks = [qty && `Quantity: ${qty}`, c.notes.trim() && `Notes: ${c.notes.trim()}`].filter(Boolean) as string[];
        items.push({ product_id: null, product_name: c.name, quantity: qty ? numberOf(qty) : null, note: picks.join(' | ').slice(0, 500) || null });
      });
      return items;
    }

    // The same request as plain text, for the copy/email fallback if the server cannot be reached.
    function compose(items: QuotationItemInput[]) {
      const v = (n: string) => field(n).value.trim();
      const names = new Map(Object.values(info).map((i) => [i.id, i.name]));
      const lines = ['Quote request via Geo Excel website', '', `Name: ${v('name')}`, `Company: ${v('company')}`, `Email: ${v('email')}`];
      if (v('phone')) lines.push(`Phone: ${v('phone')}`);
      lines.push(`Destination: ${v('country')}`);
      if (v('qty')) lines.push(`Total volume: ${v('qty')}`);
      lines.push('', 'Products:');
      if (!items.length) lines.push('- (none selected)');
      items.forEach((i) => { lines.push(`- ${(i.product_id && names.get(i.product_id)) || i.product_name || 'Product'}`); if (i.note) lines.push(`    ${i.note}`); });
      if (v('message')) lines.push('', 'Message:', v('message'));
      return lines.join('\n');
    }

    function show(kind: 'ok' | 'info' | 'bad', text: string, bold = '') {
      status.className = `status ${kind}`;
      status.replaceChildren(document.createTextNode(text));
      if (bold) { const b = document.createElement('strong'); b.textContent = bold; b.style.cssText = 'display:block;font-size:1.4rem;margin-top:6px;letter-spacing:.04em'; status.append(b); }
      status.hidden = false;
      status.focus();
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!validate()) return;
      fallback.hidden = true;
      const items = buildItems();
      const volume = field('qty').value.trim();
      const message = [field('message').value.trim(), volume && `Total volume / shipment: ${volume}`].filter(Boolean).join('\n\n').slice(0, 4000);
      send.disabled = true; send.textContent = 'Sending…';
      try {
        const ref = await submitQuotation({
          name: field('name').value.trim(), company: field('company').value.trim(), email: field('email').value.trim(),
          phone: field('phone').value.trim(), country: field('country').value.trim(), message, items, website: field('website').value,
        });
        show('ok', 'Thank you. Your quotation request has been recorded. Your reference is:', ref);
        clear(); details = {}; saveD(); customs = []; saveC(); drawBasket(); form.reset();
      } catch (err) {
        const ae = err instanceof ApiError ? err : null;
        if (ae && (ae.kind === 'invalid' || ae.kind === 'rate')) {
          show('bad', ae.message.charAt(0).toUpperCase() + ae.message.slice(1) + (/[.!?]$/.test(ae.message) ? '' : '.'));
        } else {
          show('bad', `${ae?.message ?? 'We could not send your request.'} Nothing was lost: you can email it to ${form.dataset.email} using the text below.`);
          (document.getElementById('copy-text') as HTMLTextAreaElement).value = compose(items);
          fallback.hidden = false;
        }
      } finally {
        send.disabled = false; send.textContent = 'Send enquiry';
      }
    });

    document.getElementById('copy')!.addEventListener('click', async () => {
      const ta = document.getElementById('copy-text') as HTMLTextAreaElement;
      try { await navigator.clipboard.writeText(ta.value); show('ok', 'Message copied.'); } catch { ta.select(); show('info', 'Press Ctrl+C to copy the selected message.'); }
    });

    drawBasket();
    loadProducts();
  </script>
</Base>
