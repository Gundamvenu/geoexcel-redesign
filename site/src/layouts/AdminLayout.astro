---
// Minimal shell for the admin area: no public navigation or footer, never indexed.
import '../styles/global.css';
import '../styles/admin.css';
import { u } from '../data/url';
interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <title>{title}</title>
    <link rel="icon" href={u('favicon.ico')} sizes="any" />
    <meta name="theme-color" content="#0e2235" />
  </head>
  <body class="admin">
    <a class="skip" href="#admin-main">Skip to main content</a>
    <slot />
  </body>
</html>
